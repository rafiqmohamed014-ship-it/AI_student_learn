# ---------------------------------------------------------------------------
# AI provider configuration
# ---------------------------------------------------------------------------
# Every supported provider below exposes an OpenAI-compatible
#   POST {AI_BASE_URL}/chat/completions
# endpoint, so switching provider = changing these 3 values.
#
# 1. Copy this file to  .env
# 2. Fill in AI_API_KEY
# 3. Restart the server:  npm start
# ---------------------------------------------------------------------------

# --- OpenRouter free tier (https://openrouter.ai/keys) -- DEFAULT ---
# Create a key at https://openrouter.ai/keys (starts with sk-or-v1-). No credit card needed
# for the ":free" models (limits: ~20 requests/min, 200/day).
AI_PROVIDER=openrouter
AI_API_KEY=your_api_key_here
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AI_BASE_URL=https://openrouter.ai/api/v1

# --- NVIDIA's own free API (https://build.nvidia.com) ---
# Free key starts with nvapi-. NVIDIA's model ids have NO ":free" suffix.
# AI_PROVIDER=nvidia
# AI_API_KEY=nvapi-your-key
# AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# AI_BASE_URL=https://integrate.api.nvidia.com/v1

# --- OpenAI (https://platform.openai.com/api-keys) ---
# AI_PROVIDER=openai
# AI_API_KEY=sk-your-openai-key
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# --- Groq (https://console.groq.com/keys) -- free tier, very fast ---
# AI_PROVIDER=groq
# AI_API_KEY=gsk_your_groq_key
# AI_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (https://openrouter.ai/keys) ---
# AI_PROVIDER=openrouter
# AI_API_KEY=sk_or_your_key
# AI_MODEL=openai/gpt-4o-mini

# --- Any OpenAI-compatible endpoint (Together, DeepSeek, local Ollama, ...) ---
# AI_PROVIDER=custom
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llama3.1

# Leave blank to auto-derive from AI_PROVIDER
# AI_BASE_URL=https://api.openai.com/v1

# --- Optional tuning ---
# AI_TIMEOUT_MS=60000
# Reasoning models (Nemotron etc.) need room for hidden reasoning plus the answer,
# so keep this generous. The server never sends less than 4000 tokens per request.
# AI_MAX_TOKENS=6000
# OpenRouter only: low | medium | high. 'low' stops free models burning the whole
# token budget on reasoning and then returning an empty answer.
# AI_REASONING_EFFORT=low
# PORT=3000

# --- Local MongoDB (optional; defaults to this URI) ---
# Start the MongoDB service, then connect with this URI in MongoDB Compass.
# MONGODB_URI=mongodb://127.0.0.1:27017/edunova_ai

# ---------------------------------------------------------------------------
# Supabase (OPTIONAL)
# ---------------------------------------------------------------------------
# The app runs 100% offline with a localStorage-backed store when these are
# blank. To use real Supabase auth + database:
#   1. create a project at https://supabase.com
#   2. run  supabase/schema.sql  in the SQL editor
#   3. paste the Project URL + anon public key into  /js/config.js
#      (NOT here - these two values are public by design and safe in the browser)
#   4. set Auth -> Providers -> Email -> "Confirm email" however you like
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key
